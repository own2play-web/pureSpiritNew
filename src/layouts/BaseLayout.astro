---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import InschrijvenModal from '../components/InschrijvenModal.astro';
import { ViewTransitions } from 'astro:transitions';
import '../styles/global.css';
import site from '../data/site.json';

// Pre-release: staat sitebreed op noindex. Zet op false bij de publieke
// lancering (en pas public/robots.txt aan, zie de go-live checklist).
const PRE_RELEASE = true;

interface Props {
  title: string;
  description?: string;
  image?: string;
  /** Altijd uit de index houden, ook na de lancering (bv. bedankpagina's). */
  noindex?: boolean;
  ogType?: 'website' | 'article';
  /** Extra schema.org-blokken voor deze pagina (Article, FAQPage, ...). */
  jsonLdExtra?: object[];
}

const {
  title,
  description = 'Pure Spirit – Bachbloesemtherapie, Meditatie, Coaching, Begeleiding HSP en Persoonlijke Ontwikkeling in Oss.',
  image = '/uploads/pure-spirit-logo-95px-hoog.png',
  noindex = false,
  ogType = 'website',
  jsonLdExtra = [],
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Google kapt omschrijvingen af rond 155-160 tekens; liever zelf netjes op een
// woordgrens afkappen dan midden in een zin.
function kapAf(tekst: string, max = 155) {
  if (tekst.length <= max) return tekst;
  const stuk = tekst.slice(0, max - 1);
  return `${stuk.slice(0, stuk.lastIndexOf(' ') > 0 ? stuk.lastIndexOf(' ') : max - 1)}…`;
}
const metaDescription = kapAf(description);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: site.naam,
  url: new URL('/', Astro.site).href,
  logo: new URL('/uploads/pure-spirit-logo-95px-hoog.png', Astro.site).href,
  image: new URL(image, Astro.site).href,
  sameAs: [site.facebook, site.instagram].filter(Boolean),
  telephone: site.telefoon,
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.adres,
    postalCode: site.postcode,
    addressLocality: site.stad,
    addressCountry: 'NL',
  },
  // Bewust geen openingHoursSpecification: er is geen inloop, alleen op
  // afspraak. Google zou daarmee "nu geopend" kunnen tonen. Deze tijden zijn
  // het moment waarop je een afspraak kunt plannen.
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'afspraken',
    telephone: site.telefoon,
    email: site.email,
    availableLanguage: 'nl',
    hoursAvailable: {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday'],
      opens: '09:00',
      closes: '21:30',
    },
  },
  priceRange: '€€',
};
---

<!doctype html>
<html lang="nl">
  <head>
    <script is:inline>
      // Blocking, vóór eerste render: voorkomt flits van verkeerd thema.
      // Draait ook na elke Astro view-transition (client-side navigatie),
      // want <html> zelf wordt niet als transition:persist behandeld.
      (function () {
        function pasThemaToe() {
          var opgeslagen = localStorage.getItem('ps-theme');
          var thema = opgeslagen === 'light' || opgeslagen === 'dark'
            ? opgeslagen
            : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', thema);
        }
        pasThemaToe();
        document.addEventListener('astro:after-swap', pasThemaToe);
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Pure Spirit Oss</title>
    <meta name="description" content={metaDescription} />

    {(PRE_RELEASE || noindex) && <meta name="robots" content="noindex, nofollow" />}

    <link rel="canonical" href={canonicalURL} />

    <!-- Preconnect voor externe scripts -->
    <link rel="preconnect" href="https://identity.netlify.com" />

    <!-- Google Fonts — niet-blokkerend laden -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=Nunito:wght@300;400;600;700&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=Nunito:wght@300;400;600;700&display=swap" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=Nunito:wght@300;400;600;700&display=swap" /></noscript>

    <!-- Open Graph -->
    <meta property="og:type"        content={ogType} />
    <meta property="og:locale"      content="nl_NL" />
    <meta property="og:site_name"   content="Pure Spirit Oss" />
    <meta property="og:url"         content={canonicalURL} />
    <meta property="og:title"       content={`${title} | Pure Spirit Oss`} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image"       content={new URL(image, Astro.site)} />
    <meta name="twitter:card"       content="summary" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/uploads/pure-spirit-logo-95px-hoog.png" />

    <!-- LocalBusiness structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {jsonLdExtra.map(blok => (
      <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...blok })} />
    ))}

    <!-- Netlify Identity (verplicht voor CMS redirect) -->
    <script defer src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>

    <ViewTransitions />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Naar inhoud</a>
    <Header transition:persist />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <InschrijvenModal />
  </body>
</html>

<script>
  // Feature flag: fade-in-bij-scroll. Zet op false om sitebreed uit te schakelen.
  const FADE_IN_ENABLED = true;

  // Herkenbare deelblokken binnen een sectie (kaarten, grid-items, kolommen).
  // Worden los van elkaar onthuld zodat het effect ook bij lange/grote
  // secties zichtbaar blijft terwijl je scrollt, niet alleen bovenaan.
  const REVEAL_SELECTOR = [
    '.section__header',
    '.grid > *',
    '.hsp-grid > *',
    '.about-grid > *',
    '.over-grid > *',
    '.contact-grid > *',
    '.cursus-lijst > *',
    '.binnenkort-grid > *',
    '.waarden > *',
    '.cta-bottom__kaart',
  ].join(', ');

  function initFadeIn() {
    document.documentElement.classList.remove('fade-in-active');
    document.querySelectorAll('[data-reveal-init]').forEach(el => {
      el.removeAttribute('data-reveal-init');
      el.removeAttribute('data-reveal');
      el.classList.remove('is-revealed');
    });
    if (!FADE_IN_ENABLED) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    document.documentElement.classList.add('fade-in-active');

    // Secties zonder herkenbare deelblokken vallen terug op een fade van de
    // hele sectie (bv. een losse alinea-sectie zonder grid/kaarten).
    document.querySelectorAll('.section').forEach(section => {
      // .no-reveal: belangrijke info (bv. eerstvolgende datum) die direct
      // zichtbaar moet zijn, niet pas na scrollen — anders kan het gemist
      // worden als iemand niet ver genoeg scrolt.
      if (!section.querySelector(REVEAL_SELECTOR) && !section.classList.contains('no-reveal')) {
        section.setAttribute('data-reveal', '');
      }
    });
    document.querySelectorAll(REVEAL_SELECTOR).forEach(el => el.setAttribute('data-reveal', ''));

    const targets = document.querySelectorAll('[data-reveal]:not([data-reveal-init])');
    if (!('IntersectionObserver' in window)) {
      targets.forEach(el => el.classList.add('is-revealed'));
      return;
    }

    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-revealed');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15, rootMargin: '0px 0px -10% 0px' });

    targets.forEach(el => {
      el.setAttribute('data-reveal-init', '');
      observer.observe(el);
    });
  }

  document.addEventListener('astro:page-load', initFadeIn);
</script>

<style>
  .skip-link {
    position: absolute;
    top: -100%;
    left: var(--space-4);
    background: var(--color-primary);
    color: #fff;
    padding: var(--space-2) var(--space-4);
    border-radius: 0 0 var(--radius-md) var(--radius-md);
    font-weight: 700;
    text-decoration: none;
    z-index: 9999;
    transition: top 0.1s;
  }
  .skip-link:focus {
    top: 0;
  }
</style>
