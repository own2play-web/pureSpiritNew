---
import BaseLayout from './BaseLayout.astro';
import HeroVisual from '../components/HeroVisual.astro';

interface Props {
  title: string;
  description?: string;
  hero?: boolean;
  heroTitle?: string;
  heroSubtitle?: string;
  /** Zelfde ademende-cirkels-animatie als de homepage-hero, met een icoon
      passend bij het onderwerp van de pagina — altijd de subtiele variant
      hier, de volle homepage-versie zit alleen in Hero.astro. Standaard
      'lotus' (zelfde icoon als de homepage) als een pagina geen eigen
      icoon opgeeft, zodat elke pagina met een hero er een heeft. */
  heroIcon?: 'lotus' | 'lotusbloem' | 'lotusbloei' | 'spastenen' | 'groep' | 'bloesem' | 'pad' | 'beek' | 'profiel' | 'hart' | 'kalender' | 'citaat' | 'kompas' | 'muntstuk';
}

const { title, description, hero = true, heroTitle, heroSubtitle, heroIcon = 'lotus' } = Astro.props;
---

<BaseLayout title={title} description={description}>
  {hero && (
    <section class="page-hero">
      <div class="container page-hero__inner">
        <div class="page-hero__content">
          <h1>{heroTitle || title}</h1>
          {heroSubtitle && <p class="lead">{heroSubtitle}</p>}
          <hr class="divider" style="margin: var(--space-4) 0;" />
        </div>
        {heroIcon && (
          <div class="page-hero__visual">
            <HeroVisual icon={heroIcon} subtle />
          </div>
        )}
      </div>
    </section>
  )}
  <slot />
</BaseLayout>

<style>
  .page-hero {
    background-color: var(--color-primary-light);
    padding-block: var(--space-16);
    border-bottom: 1px solid var(--color-border);
    overflow: hidden;
  }

  .page-hero__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-12);
  }

  .page-hero h1 {
    color: var(--color-primary-dark);
    margin-bottom: var(--space-3);
  }

  .page-hero .lead {
    max-width: 600px;
    color: var(--color-text-muted);
  }

  .page-hero__visual {
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .page-hero__visual { display: none; }
  }
</style>
