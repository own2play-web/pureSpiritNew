---
type DagInfo = { titel: string; activiteit?: string; leeftijd?: string; isStart: boolean; cursusId: string };

interface Props {
  jaar: number;
  maand: number;
  maandNamen: string[];
  dagKort: string[];
  dagMap: Record<string, DagInfo[]>;
  vandaagSleutel: string;
  typeBg: Record<string, string>;
  typeKleur: Record<string, string>;
}

const { jaar, maand, maandNamen, dagKort, dagMap, vandaagSleutel, typeBg, typeKleur } = Astro.props;

function buildCellen(jaar: number, maand: number): (number | null)[] {
  const eersteDag   = new Date(jaar, maand, 1);
  const aantaldagen = new Date(jaar, maand + 1, 0).getDate();
  let startKolom    = eersteDag.getDay() - 1;
  if (startKolom < 0) startKolom = 6;
  const cellen: (number | null)[] = Array(startKolom).fill(null);
  for (let d = 1; d <= aantaldagen; d++) cellen.push(d);
  while (cellen.length % 7 !== 0) cellen.push(null);
  while (cellen.length < 42) cellen.push(null); // altijd 6 rijen = gelijke kaardhoogte
  return cellen;
}

function datumSleutel(jaar: number, maand: number, dag: number) {
  return `${jaar}-${String(maand + 1).padStart(2,'0')}-${String(dag).padStart(2,'0')}`;
}

const cellen = buildCellen(jaar, maand);
---

<div class="kalender-maand">
  <h3 class="kalender-maand__titel">{maandNamen[maand]} {jaar}</h3>
  <div class="kalender-dag-namen">
    {dagKort.map(d => <span>{d}</span>)}
  </div>
  <div class="kalender-cellen">
    {cellen.map(dag => {
      if (!dag) return <span class="cel cel--leeg" />;

      const sleutel     = datumSleutel(jaar, maand, dag);
      const items       = dagMap[sleutel] ?? [];
      const isVandaag   = sleutel === vandaagSleutel;
      const startItems  = items.filter(d => d.isStart);
      const vervolgItems = items.filter(d => !d.isStart);
      const heeftStart  = startItems.length > 0;
      const cursusId    = items[0]?.cursusId ?? '';

      // Voor de filterbalk: alle activiteiten/leeftijden van alle cursussen
      // die deze dag spelen (start of vervolgles), zodat een cel meetelt
      // als je op een van die tags filtert.
      const dagActiviteiten = Array.from(new Set(items.map(it => it.activiteit).filter(Boolean)));
      const dagLeeftijden   = Array.from(new Set(items.map(it => it.leeftijd).filter(Boolean)));

      // Kleur van de cel: als er een startdatum is, komt de kleur altijd van
      // de gestartE cursus — ook als dezelfde dag toevallig een vervolgles
      // van een andere cursus valt. Die andere cursus krijgt in plaats
      // daarvan een eigen gekleurd stipje (zie vervolgKleur), zodat de
      // startkleur niet vermengd (voorheen: half-om-half gradient) hoeft te
      // worden met een cursus die vandaag niet eens start.
      const kleurBron         = heeftStart ? startItems : items;
      const kleurActiviteiten = Array.from(new Set(kleurBron.map(it => it.activiteit).filter(Boolean)));
      const kleurLeeftijden   = Array.from(new Set(kleurBron.map(it => it.leeftijd).filter(Boolean)));

      let c1: string | null = null;
      let c2: string | null = null;
      let kleur: string | null = null;
      if (kleurActiviteiten.length >= 2) {
        c1 = typeBg[kleurActiviteiten[0]];
        c2 = typeBg[kleurActiviteiten[1]];
        kleur = typeKleur[kleurActiviteiten[0]];
      } else if (kleurActiviteiten.length === 1) {
        c1 = typeBg[kleurActiviteiten[0]];
        c2 = kleurLeeftijden[0] ? typeBg[kleurLeeftijden[0]] : null;
        kleur = typeKleur[kleurActiviteiten[0]];
      } else if (kleurLeeftijden.length > 0) {
        c1 = typeBg[kleurLeeftijden[0]];
        c2 = kleurLeeftijden[1] ? typeBg[kleurLeeftijden[1]] : null;
        kleur = typeKleur[kleurLeeftijden[0]];
      }

      // Stipje voor een vervolgles van een andere cursus op een startdag:
      // eigen kleur (van die vervolgcursus zelf), los van --cel-kleur
      // hierboven (dat blijft de kleur van de gestarte cursus).
      const vervolgActiviteiten = Array.from(new Set(vervolgItems.map(it => it.activiteit).filter(Boolean)));
      const vervolgLeeftijden   = Array.from(new Set(vervolgItems.map(it => it.leeftijd).filter(Boolean)));
      const vervolgKleur = heeftStart && vervolgItems.length > 0
        ? (typeKleur[vervolgActiviteiten[0]] ?? typeKleur[vervolgLeeftijden[0]] ?? null)
        : null;

      const stijl = c1
        ? `--cel-c1:${c1};${c2 ? `--cel-c2:${c2};` : ''}--cel-kleur:${kleur};${vervolgKleur ? `--cel-vervolg-kleur:${vervolgKleur};` : ''}`
        : '';

      const tooltip = items
        .map(d => `${d.isStart ? '▶ Start' : '· Vervolgles'}: ${d.titel}`)
        .join('\n');

      return items.length > 0 ? (
        <button
          class:list={['cel', isVandaag && 'cel--vandaag', heeftStart ? 'cel--start' : 'cel--vervolg', heeftStart && vervolgItems.length > 0 && 'cel--met-vervolg']}
          style={stijl}
          data-tooltip={tooltip}
          data-cursus-id={cursusId}
          data-activiteit={dagActiviteiten.join('|')}
          data-leeftijd={dagLeeftijden.join('|')}
          type="button"
        >
          {dag}
        </button>
      ) : (
        <span class:list={['cel', isVandaag && 'cel--vandaag']}>{dag}</span>
      );
    })}
  </div>
</div>

<style>
  .kalender-maand {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
  }

  .kalender-maand__titel {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-primary-dark);
    text-align: center;
    margin-bottom: var(--space-3);
  }

  .kalender-dag-namen {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    margin-bottom: var(--space-1);
  }

  .kalender-dag-namen span {
    font-family: var(--font-body);
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--color-text-muted);
    text-align: center;
    padding-block: var(--space-1);
  }

  .kalender-cellen {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 2px;
  }

  .cel {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-text);
    border-radius: var(--radius-sm);
    font-weight: 400;
    background: none;
    border: none;
    padding: 0;
    cursor: default;
  }

  .cel--leeg { visibility: hidden; }

  .cel--vandaag {
    outline: 2px solid var(--color-primary);
    outline-offset: -2px;
    font-weight: 700;
  }

  /* Startdatum: gevulde gekleurde achtergrond. --cel-c2 valt terug op
     --cel-c1 (via de var()-fallback) zodat een cursus met maar één tag
     gewoon een vlakke kleur krijgt — de gradient-syntax is dan alleen
     intern nog aanwezig, niet zichtbaar als aparte kleuren. */
  .cel--start {
    background: linear-gradient(to bottom, var(--cel-c1) 50%, var(--cel-c2, var(--cel-c1)) 50%);
    color: var(--cel-kleur);
    font-weight: 700;
    cursor: pointer;
  }

  :global(html[data-theme='dark']) .cel--start {
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--cel-c1) 25%, var(--color-surface)) 50%,
      color-mix(in srgb, var(--cel-c2, var(--cel-c1)) 25%, var(--color-surface)) 50%
    );
    color: color-mix(in srgb, var(--cel-kleur) 70%, white);
  }

  .cel--start:hover {
    filter: brightness(0.93);
  }

  /* Cellen die niet matchen met de actieve filter (agenda.astro) — gedimd
     i.p.v. verborgen, anders valt de kalendergrid uit elkaar. */
  .cel--gedimd {
    opacity: 0.3;
    filter: grayscale(60%);
  }

  /* Vervolgles: stippeltje onder het getal */
  .cel--vervolg {
    color: var(--color-text);
    cursor: pointer;
  }

  .cel--vervolg:hover {
    background-color: var(--color-primary-light);
  }

  .cel--vervolg::after {
    content: '';
    position: absolute;
    bottom: 3px;
    left: 50%;
    transform: translateX(-50%);
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background-color: var(--cel-kleur, var(--color-primary));
  }

  /* Startcel die dezelfde dag ook een vervolgles van een andere cursus
     heeft: eigen gekleurd stipje bovenop de startkleur (i.p.v. de
     startkleur te vermengen met een cursus die vandaag niet start). */
  .cel--start.cel--met-vervolg::after {
    content: '';
    position: absolute;
    bottom: 3px;
    left: 50%;
    transform: translateX(-50%);
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background-color: var(--cel-vervolg-kleur, var(--cel-kleur));
  }
</style>
