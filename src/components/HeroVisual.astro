<style>
  .hero-visual {
    position: relative;
    width: 220px;
    height: 220px;
    flex-shrink: 0;
    color: var(--color-primary);
  }

  .hero-visual__circle {
    position: absolute;
    border-radius: 50%;
    border: 1px solid var(--color-primary);
    opacity: 0.2;
  }

  .hero-visual__circle--1 {
    inset: 0;
    animation: hero-visual-pulse 4s ease-in-out infinite;
  }

  .hero-visual__circle--2 {
    inset: 20px;
    opacity: 0.12;
    animation: hero-visual-pulse 4s ease-in-out infinite 1s;
  }

  .hero-visual__icon {
    position: absolute;
    inset: 50%;
    transform: translate(calc(-50% + var(--icon-offset-x, 0px)), calc(-50% + var(--icon-offset-y, 0px))) scale(var(--icon-scale, 1));
    color: var(--color-primary);
  }

  :global(html[data-theme='dark']) .hero-visual__circle    { opacity: 0.4; }
  :global(html[data-theme='dark']) .hero-visual__circle--2 { opacity: 0.28; }
  :global(html[data-theme='dark']) .hero-visual__icon      { filter: brightness(1.8); }

  /* Subtiele variant: kleiner geheel, dichter bij het midden van de cirkels
     (icoon kwam anders bijna tegen de binnenste cirkel aan), gedempte
     opacity en een tragere, rustigere pols. */
  .hero-visual--subtle {
    width: 160px;
    height: 160px;
  }

  .hero-visual--subtle .hero-visual__icon {
    --icon-scale: 0.55;
    /* Zelfde afstand tot het midden (38px) als de eerdere rechte
       positionering, nu verdeeld over beide assen voor een 45°-hoek
       rechtsonder — anders komt de afstand tot het midden (en dus hoever
       hij over de cirkel heen steekt) hoger uit dan bedoeld. */
    --icon-offset-x: 21px;
    --icon-offset-y: 21px;
    opacity: 0.9;
  }

  .hero-visual--subtle .hero-visual__circle--1,
  .hero-visual--subtle .hero-visual__circle--2 {
    animation-name: hero-visual-pulse-subtle;
    animation-duration: 6s;
  }

  :global(html[data-theme='dark']) .hero-visual--subtle .hero-visual__circle    { opacity: 0.14; }
  :global(html[data-theme='dark']) .hero-visual--subtle .hero-visual__circle--2 { opacity: 0.1; }

  @keyframes hero-visual-pulse {
    0%, 100% { transform: scale(1);   opacity: 0.2; }
    50%       { transform: scale(1.05); opacity: 0.1; }
  }

  /* Zelfde beweging als hero-visual-pulse, maar gedempte opacity-waarden —
     een losse keyframe is nodig omdat de animatie de opacity elke frame
     zelf bepaalt en zo de statische --subtle opacity anders zou overschrijven. */
  @keyframes hero-visual-pulse-subtle {
    0%, 100% { transform: scale(1);   opacity: 0.16; }
    50%       { transform: scale(1.05); opacity: 0.09; }
  }
</style>
