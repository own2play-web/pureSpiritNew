// wisselend icoon per pagina-onderwerp.
interface Props {
  icon?: 'lotus' | 'lotusbloem' | 'lotusbloei' | 'spastenen' | 'groep' | 'bloesem' | 'pad' | 'beek' | 'profiel' | 'hart' | 'kalender' | 'citaat' | 'kompas' | 'muntstuk';
