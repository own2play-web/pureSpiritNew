---
// Klein archief-icoon met uitleg bij hover/focus. Voor oudere nieuwsberichten.
const tekst = 'Archiefbericht: kan verouderd zijn. Bekijk het nieuws en de agenda voor actuele informatie.';
---

<span class="archief" tabindex="0" role="img" aria-label={tekst}>
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="3" y="4" width="18" height="5" rx="1" />
    <path d="M5 9v9a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V9" />
    <path d="M10 13h4" />
  </svg>
  <span class="archief__tip" role="tooltip" aria-hidden="true">{tekst}</span>
</span>

<style>
  .archief {
    position: relative;
    display: inline-flex;
    align-items: center;
    color: var(--color-text-muted);
    cursor: help;
    border-radius: var(--radius-sm);
    outline-offset: 2px;
  }

  .archief:hover,
  .archief:focus-visible {
    color: var(--color-primary);
  }

  .archief__tip {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    width: max-content;
    max-width: 240px;
    padding: var(--space-2) var(--space-3);
    background-color: var(--color-primary-dark);
    color: #fff;
    font-size: var(--text-xs);
    font-weight: 400;
    line-height: 1.5;
    text-align: left;
    text-transform: none;
    letter-spacing: 0;
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-md);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity var(--transition);
    z-index: 20;
  }

  .archief:hover .archief__tip,
  .archief:focus .archief__tip,
  .archief:focus-visible .archief__tip {
    opacity: 1;
    visibility: visible;
  }

  :global(html[data-theme='dark']) .archief__tip {
    background-color: var(--color-surface);
    color: var(--color-text);
    border: 1px solid var(--color-border-strong);
  }
</style>
