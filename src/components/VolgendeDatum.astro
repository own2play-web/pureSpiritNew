---
// Toont de eerstvolgende start van een nog niet gestarte groep voor deze
// meditatie-/workshoppagina. De koppeling loopt via meditatie_pagina /
// workshop_pagina op de agenda-items (src/data/agenda.json): één bron van
// waarheid, geen koppeling op naam en geen los ingetypte datum.
import agendaData from '../data/agenda.json';

interface Props {
  /** Slug van deze pagina, zoals gekozen in de agenda. */
  slug: string;
  soort: 'meditatie' | 'workshop';
}

const { slug, soort } = Astro.props;

function slugify(s: string) {
  return s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
}

const maandNamen = ['januari','februari','maart','april','mei','juni',
                    'juli','augustus','september','oktober','november','december'];

const vandaag = new Date();
vandaag.setHours(0, 0, 0, 0);

// Alleen de startdatum van een nog niet gestarte groep telt: voor wie wil
// instappen is een vervolgles of een lopende cursus geen "volgende keer".
// Meerdere groepen van dezelfde pagina: de eerstvolgende start wint.
const veld = soort === 'meditatie' ? 'meditatie_pagina' : 'workshop_pagina';
const groepen = (agendaData.cursussen as any[])
  .filter(c => c[veld] === slug && c.data[0] && new Date(c.data[0]) >= vandaag)
  .sort((a, b) => new Date(a.data[0]).getTime() - new Date(b.data[0]).getTime());
const cursus = groepen[0];
const volgende: string | undefined = cursus?.data[0];

function formatDatum(datumStr: string) {
  const d = new Date(datumStr);
  return `${d.getDate()} ${maandNamen[d.getMonth()]} ${d.getFullYear()}`;
}

const cursusId = cursus ? `cursus-${slugify(cursus.titel)}` : '';
---

<div class="volgende-datum">
  {volgende ? (
    <>
      <p class="volgende-datum__label">Eerstvolgende start</p>
      <p class="volgende-datum__datum">{formatDatum(volgende)}{cursus?.tijdstip && cursus.tijdstip !== 'Nader te bepalen' ? ` · ${cursus.tijdstip}` : ''}</p>
      <a href={`/agenda/#${cursusId}`} class="btn btn--outline">Bekijk in de agenda</a>
    </>
  ) : (
    <>
      <p class="volgende-datum__label">Nog geen nieuwe groep gepland</p>
      <p class="volgende-datum__toelichting">Neem contact op voor de mogelijkheden of om je interesse aan te geven.</p>
      <a href="/contact/" class="btn btn--outline">Neem contact op</a>
    </>
  )}
</div>

<style>
  .volgende-datum {
    background-color: var(--color-primary-light);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    text-align: center;
  }

  .volgende-datum__label {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-primary);
    margin-bottom: var(--space-2);
  }

  .volgende-datum__datum {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--color-primary-dark);
    margin-bottom: var(--space-5);
  }

  .volgende-datum__toelichting {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    max-width: 360px;
    margin-inline: auto;
    margin-bottom: var(--space-5);
  }
</style>
