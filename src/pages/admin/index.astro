---
// CMS-beheerpanel (Decap/Netlify CMS) — buiten de normale site-layout
// local_backend: true in public/cms-config.yml + draai npx netlify-cms-proxy-server
---
<!doctype html>
<html lang="nl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Pure Spirit – Content beheer</title>
  <script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
  <link href="/cms-config.yml" type="text/yaml" rel="cms-config-url" />
</head>
<body>
  <a id="publiceer-link" href="/admin/publiceer/" hidden style="
    position: fixed; bottom: 24px; right: 24px; z-index: 9999;
    background: #246482; color: #fff; text-decoration: none;
    padding: 0.75rem 1.5rem; border-radius: 10px;
    font-family: system-ui, sans-serif; font-size: 0.95rem; font-weight: 700;
    box-shadow: 0 4px 16px rgba(0,0,0,0.2);
  ">🚀 Publiceer website</a>
  <script is:inline src="https://unpkg.com/netlify-cms@^2.0.0/dist/netlify-cms.js"></script>
  <script is:inline>
    CMS.registerPreviewStyle('/admin/preview.css');

    // Toon de publiceer-link pas na een bevestigde ingelogde sessie — zelfde
    // reden als op /admin/publiceer/ zelf: niemand die nog niet is ingelogd
    // hoort deze knop zelfs maar te zien.
    const publiceerLink = document.getElementById('publiceer-link');
    netlifyIdentity.on('init',   user => { publiceerLink.hidden = !user; });
    netlifyIdentity.on('login',  () => { publiceerLink.hidden = false; });
    netlifyIdentity.on('logout', () => { publiceerLink.hidden = true; });
    netlifyIdentity.init();
  </script>
</body>
</html>
