---
// Standalone pagina buiten de normale layout — geen header/footer nodig
---
<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Publiceer website – Pure Spirit</title>
  <script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Nunito', system-ui, sans-serif;
      background: #f0f7fb;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem;
    }

    .kaart {
      background: #fff;
      border-radius: 16px;
      box-shadow: 0 4px 24px rgba(0,0,0,0.10);
      padding: 3rem 2.5rem;
      max-width: 480px;
      width: 100%;
      text-align: center;
    }

    .icoon { font-size: 3rem; margin-bottom: 1rem; }

    h1 {
      font-size: 1.6rem;
      color: #1a4a61;
      margin-bottom: 0.75rem;
    }

    p {
      color: #5a7480;
      line-height: 1.6;
      margin-bottom: 2rem;
      font-size: 0.95rem;
    }

    button {
      background: #246482;
      color: #fff;
      border: none;
      border-radius: 10px;
      padding: 0.9rem 2.5rem;
      font-size: 1.05rem;
      font-weight: 700;
      cursor: pointer;
      transition: background 200ms, transform 100ms;
      width: 100%;
    }

    button:hover:not(:disabled) { background: #1a4a61; }
    button:active:not(:disabled) { transform: scale(0.98); }
    button:disabled { opacity: 0.6; cursor: not-allowed; }

    .status {
      margin-top: 1.5rem;
      padding: 1rem;
      border-radius: 10px;
      font-size: 0.9rem;
      font-weight: 700;
      display: none;
    }

    .status--bezig  { background: #e6f2f7; color: #246482; display: block; }
    .status--succes { background: #d1f0e8; color: #0d5c42; display: block; }
    .status--info   { background: #e6f2f7; color: #246482; display: block; }
    .status--fout   { background: #fee2e2; color: #9b1c1c; display: block; }

    .terug {
      display: inline-block;
      margin-top: 1.5rem;
      color: #246482;
      text-decoration: none;
      font-size: 0.9rem;
    }
    .terug:hover { text-decoration: underline; }

    /* ── Bevestig-overlay ────────────────────────────────────── */
    .overlay {
      position: fixed;
      inset: 0;
      z-index: 10;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(26, 74, 97, 0.45);
      padding: 1.5rem;
    }
    .overlay[hidden] { display: none; }

    .bevestig-kaart {
      background: #fff;
      border-radius: 16px;
      box-shadow: 0 8px 32px rgba(0,0,0,0.18);
      padding: 2.5rem 2rem;
      max-width: 440px;
      width: 100%;
      text-align: left;
    }

    .bevestig-kaart h2 {
      font-size: 1.3rem;
      color: #1a4a61;
      margin-bottom: 1rem;
    }

    .bevestig-kaart p {
      text-align: left;
      font-size: 0.9rem;
      margin-bottom: 1.25rem;
    }

    .bevestig-kaart p:last-of-type { margin-bottom: 1.5rem; }

    .bevestig-kaart a {
      color: #246482;
      font-weight: 700;
    }

    .bevestig-knoppen {
      display: flex;
      gap: 0.75rem;
    }

    .bevestig-knoppen button { width: auto; flex: 1; font-size: 0.95rem; padding: 0.75rem 1rem; }

    #bevestig-annuleer {
      background: #eef2f5;
      color: #1a4a61;
    }
    #bevestig-annuleer:hover:not(:disabled) { background: #dde5ea; }

    #bevestig-ga-door {
      background: #b45309;
    }
    #bevestig-ga-door:hover:not(:disabled) { background: #8a3f06; }
  </style>
</head>
<body>
  <div class="kaart">
    <div class="icoon">🚀</div>
    <h1>Website publiceren</h1>
    <p>
      Klik op de knop om alle wijzigingen die je hebt opgeslagen live te zetten.
      Dit duurt ongeveer 1–2 minuten.
    </p>

    <button id="publiceer-btn" onclick="vraagBevestiging()" disabled>
      Publiceer website
    </button>

    <div id="login-nodig" hidden>
      <p>Je bent niet (meer) ingelogd. Log in om te kunnen publiceren.</p>
      <button id="login-btn" type="button">Inloggen</button>
    </div>

    <div id="status" class="status"></div>

    <a href="/admin/" class="terug">← Terug naar beheer</a>
  </div>

  <div id="bevestig-overlay" class="overlay" hidden>
    <div class="bevestig-kaart">
      <h2>Weet je het zeker?</h2>
      <p>
        Deze knop zet alles wat momenteel op de testomgeving staat direct live
        op de echte website (purespirit-oss.nl). Dit gebeurt meteen en kan niet
        via deze knop worden teruggedraaid.
      </p>
      <p>
        Controleer daarom eerst of alles er goed uitziet op de testomgeving:<br />
        <a href="https://purespiritnew.thijsvgeel.workers.dev/" target="_blank" rel="noopener">
          purespiritnew.thijsvgeel.workers.dev
        </a>
      </p>
      <p>Zie je daar alles kloppen? Klik dan hieronder op "Ja, publiceer".</p>
      <div class="bevestig-knoppen">
        <button id="bevestig-annuleer" type="button">Annuleren</button>
        <button id="bevestig-ga-door" type="button">Ja, publiceer</button>
      </div>
    </div>
  </div>

  <script is:inline>
    const btn            = document.getElementById('publiceer-btn');
    const loginNodig     = document.getElementById('login-nodig');
    const loginBtn       = document.getElementById('login-btn');
    const status         = document.getElementById('status');
    const bevestigOverlay = document.getElementById('bevestig-overlay');
    const bevestigAnnuleer = document.getElementById('bevestig-annuleer');
    const bevestigGaDoor   = document.getElementById('bevestig-ga-door');

    function toonIngelogd() {
      loginNodig.hidden = true;
      btn.hidden    = false;
      btn.disabled  = false;
    }

    function toonUitgelogd() {
      btn.hidden         = true;
      loginNodig.hidden  = false;
    }

    // Alleen ingelogde (Netlify Identity) gebruikers mogen publiceren — de
    // knop blijft verborgen/disabled tot we dat hebben bevestigd, zodat er
    // geen moment is waarop iemand zonder sessie toch kan klikken.
    netlifyIdentity.on('init',   user => user ? toonIngelogd() : toonUitgelogd());
    netlifyIdentity.on('login',  () => { toonIngelogd(); netlifyIdentity.close(); });
    netlifyIdentity.on('logout', toonUitgelogd);
    netlifyIdentity.init();

    loginBtn?.addEventListener('click', () => netlifyIdentity.open('login'));

    // Publiceren is onomkeerbaar (via deze knop) en gaat direct naar de
    // live site — vandaar eerst een bevestigingsvenster i.p.v. de publicatie
    // meteen bij de eerste klik te starten. Pas de "Ja, publiceer"-knop
    // daarin start de echte actie.
    function vraagBevestiging() {
      const user = netlifyIdentity.currentUser();
      if (!user) { netlifyIdentity.open('login'); return; }
      bevestigOverlay.hidden = false;
    }

    bevestigAnnuleer?.addEventListener('click', () => { bevestigOverlay.hidden = true; });
    bevestigGaDoor?.addEventListener('click', () => {
      bevestigOverlay.hidden = true;
      publiceer();
    });
    bevestigOverlay?.addEventListener('click', e => {
      if (e.target === bevestigOverlay) bevestigOverlay.hidden = true;
    });
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape' && !bevestigOverlay.hidden) bevestigOverlay.hidden = true;
    });

    async function publiceer() {
      const user = netlifyIdentity.currentUser();
      if (!user) { netlifyIdentity.open('login'); return; }

      btn.disabled  = true;
      btn.textContent = 'Bezig met publiceren…';
      status.className = 'status status--bezig';
      status.textContent = '⏳ Wijzigingen worden verwerkt…';

      try {
        const jwt = await user.jwt();
        const res  = await fetch('/.netlify/functions/publiceer', {
          method: 'POST',
          headers: { Authorization: `Bearer ${jwt}` },
        });
        const data = await res.json();

        if (res.ok && data.ok && data.veranderd) {
          status.className = 'status status--succes';
          status.textContent = '✅ Gelukt! De website wordt nu bijgewerkt (duurt ~1–2 minuten).';
          btn.textContent = 'Gepubliceerd!';
        } else if (res.ok && data.ok) {
          status.className = 'status status--info';
          status.textContent = 'ℹ️ ' + (data.bericht || 'Alles is al up-to-date — niets nieuws om te publiceren.');
          btn.disabled  = false;
          btn.textContent = 'Publiceer website';
        } else {
          throw new Error(data.fout || 'Onbekende fout');
        }
      } catch (e) {
        status.className = 'status status--fout';
        status.textContent = '❌ Er ging iets mis: ' + e.message;
        btn.disabled    = false;
        btn.textContent = 'Opnieuw proberen';
      }
    }
  </script>
</body>
</html>
