---
import PageLayout from '../layouts/PageLayout.astro';
import AgendaKalender from '../components/AgendaKalender.astro';
import agendaData from '../data/agenda.json';
import { getCollection } from 'astro:content';

const vandaag = new Date();
vandaag.setHours(0, 0, 0, 0);

// Koppelt een agenda-cursusnaam aan de bijbehorende activiteitenpagina, zodat
// elke agendakaart een "Meer info"-link naar de volledige beschrijving kan
// tonen. Matcht op agenda_titel (indien ingevuld) of anders titel — zelfde
// koppeling als VolgendeDatum.astro, maar dan omgekeerd.
const [alleMeditatie, alleWorkshops] = await Promise.all([
  getCollection('meditatie'),
  getCollection('workshops'),
]);
const activiteitLink = new Map<string, string>();
for (const c of alleMeditatie) activiteitLink.set(c.data.agenda_titel || c.data.titel, `/activiteiten/meditatie/${c.slug}/`);
for (const w of alleWorkshops) activiteitLink.set(w.data.agenda_titel || w.data.titel, `/activiteiten/workshops/${w.slug}/`);

const maandNamen = ['januari','februari','maart','april','mei','juni',
                    'juli','augustus','september','oktober','november','december'];
const maandKort  = ['jan','feb','mrt','apr','mei','jun',
                    'jul','aug','sep','okt','nov','dec'];

function slugify(s: string) {
  return s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
}

function formatDatum(datumStr: string) {
  const d = new Date(datumStr);
  return `${d.getDate()} ${maandNamen[d.getMonth()]} ${d.getFullYear()}`;
}

// Filter: cursus is relevant zolang er nog een sessie (start of vervolgles)
// in de toekomst ligt — niet alleen de startdatum. Anders verdwijnt een
// langlopende cursus (bv. 5 maanden) uit dit overzicht zodra hij begonnen
// is, ook al kun je nog instappen (zie instap_mogelijk hieronder).
const komend = agendaData.cursussen
  .filter(c => c.data.some(d => new Date(d) >= vandaag))
  .sort((a, b) => volgendeDatum(a).getTime() - volgendeDatum(b).getTime());

function volgendeDatum(cursus: { data: string[] }) {
  const volgende = cursus.data.find(d => new Date(d) >= vandaag);
  return new Date(volgende ?? cursus.data[0]);
}

// Binnenkort: activiteiten zonder geplande datum (animo, nieuwe data volgen)
const binnenkort = agendaData.cursussen
  .filter(c => c.data.length === 0)
  .sort((a, b) => a.titel.localeCompare(b.titel, 'nl'));

// Groepeer op maand van de eerstvolgende (nog niet geweest) sessie, i.p.v.
// altijd de oorspronkelijke startmaand — zo staat een al gestarte cursus
// bij de maand die nu relevant is.
const maanden: Record<string, typeof komend> = {};
for (const cursus of komend) {
  const d    = volgendeDatum(cursus);
  const sleu = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
  if (!maanden[sleu]) maanden[sleu] = [];
  maanden[sleu].push(cursus);
}

const typekleur: Record<string, string> = {
  'Meditatie':  'badge--meditatie',
  'Jongeren':   'badge--jongeren',
  'Coaching':   'badge--coaching',
  'HSP':        'badge--hsp',
  'Workshop':   'badge--workshop',
  'Kinderen':   'badge--kinderen',
  'Cursus':     'badge--cursus',
};

// Filterbalk: alle tags die daadwerkelijk voorkomen, in een vaste volgorde
// (i.p.v. willekeurige volgorde van voorkomen) zodat de balk niet steeds
// anders oogt als er cursussen bij komen.
const alleTags = Object.keys(typekleur).filter(tag =>
  agendaData.cursussen.some(c => (c.types ?? []).includes(tag))
);
---

<PageLayout
  title="Agenda"
  heroTitle="Agenda"
  heroSubtitle="Bekijk wanneer de eerstvolgende cursussen starten en schrijf je in."
  description="Agenda van Pure Spirit Oss – meditatiecursussen, workshops en sessies in Oss."
>
  <section class="section">
    <div class="container">
      {komend.length > 0 && (
        <AgendaKalender cursussen={agendaData.cursussen} />
      )}

      {alleTags.length > 0 && (
        <div class="filter-balk" role="group" aria-label="Filter cursussen op type">
          <span class="filter-balk__label">Filter:</span>
          {alleTags.map(tag => (
            <button type="button" class:list={['filter-chip', typekleur[tag]]} data-filter-tag={tag} aria-pressed="false">
              {tag}
            </button>
          ))}
          <button type="button" class="filter-chip filter-chip--wis" data-filter-wis>Wis filter ✕</button>
        </div>
      )}

      {Object.keys(maanden).length === 0 ? (
        <p class="geen-cursussen">Er zijn momenteel geen komende cursussen gepland. Kom later terug of neem <a href="/contact/">contact op</a> voor meer informatie.</p>
      ) : (
        Object.entries(maanden).map(([sleutel, cursussen]) => {
          const [jaar, maand] = sleutel.split('-');
          const maandNaam = maandNamen[Number(maand) - 1];
          return (
            <div class="maand-groep">
              <h2 class="maand-titel">{maandNaam} {jaar}</h2>
              <ul class="cursus-lijst">
                {cursussen.map(cursus => {
                  const { titel, types, tijdstip, locatie, prijs, bijeenkomsten, doelgroep, max_plaatsen, status, instap_mogelijk, beschrijving, data } = cursus as any;
                  const cursusTypes: string[] = types ?? [];
                  const startDatum   = data[0];
                  const alGestart    = new Date(startDatum) < vandaag;
                  // Bij een al gestarte (maar nog lopende) cursus tonen we de
                  // eerstvolgende les groot i.p.v. de allang gepasseerde
                  // startdatum, en de overige-lessen-lijst toont alleen wat
                  // nog moet komen.
                  const weergaveDatum = alGestart ? volgendeDatum(cursus).toISOString().slice(0,10) : startDatum;
                  const overigData  = data.filter((d: string) => d !== weergaveDatum && new Date(d) >= vandaag);
                  const startD      = new Date(weergaveDatum);
                  return (
                    <li class="cursus-kaart" id={`cursus-${slugify(titel)}`} data-types={cursusTypes.join(' ')}>
                      <div class="cursus-datum-blok">
                        <span class="cursus-dag">{startD.getDate()}</span>
                        <span class="cursus-maand">{maandKort[startD.getMonth()]}</span>
                      </div>
                      <div class="cursus-inhoud">
                        <div class="cursus-header">
                          <h3 class="cursus-titel">{titel}</h3>
                          {cursusTypes.map(t => (
                            <span class:list={['badge', typekleur[t] ?? 'badge--overig']}>{t}</span>
                          ))}
                          {alGestart && instap_mogelijk && (
                            <span class="badge badge--instap">Loopt al · instappen mogelijk</span>
                          )}
                        </div>
                        {beschrijving && <p class="cursus-beschrijving">{beschrijving}</p>}
                        {activiteitLink.has(titel) && (
                          <a href={activiteitLink.get(titel)} class="cursus-lees-meer">Lees meer over deze cursus →</a>
                        )}
                        <ul class="cursus-meta">
                          {tijdstip && tijdstip !== 'Nader te bepalen' && (
                            <li>
                              <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                              {tijdstip}
                            </li>
                          )}
                          {bijeenkomsten && (
                            <li>
                              <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                              {bijeenkomsten} {bijeenkomsten === 1 ? 'bijeenkomst' : 'bijeenkomsten'}
                            </li>
                          )}
                          {prijs && (
                            <li>
                              <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10h12"/><path d="M4 14h9"/><path d="M19 6a7.7 7.7 0 0 0-5.2-2A7.9 7.9 0 0 0 6 12a7.9 7.9 0 0 0 7.8 8 7.7 7.7 0 0 0 5.2-2"/></svg>
                              {prijs}
                            </li>
                          )}
                          {doelgroep && (
                            <li>
                              <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                              {doelgroep}
                            </li>
                          )}
                          {!doelgroep && max_plaatsen && (
                            <li>
                              <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                              Max. {max_plaatsen} personen
                            </li>
                          )}
                          <li>
                            <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                            {locatie}
                          </li>
                        </ul>
                        {overigData.length > 0 && (
                          <p class="overige-data">
                            <span class="overige-data__label">Overige lessen:</span>
                            {overigData.map((d, i) => {
                              const dt = new Date(d);
                              return (
                                <span class="overige-data__datum">
                                  {dt.getDate()} {maandKort[dt.getMonth()]}{i < overigData.length - 1 ? ' ·' : ''}
                                </span>
                              );
                            })}
                          </p>
                        )}
                      </div>
                      <div class="cursus-actie">
                        {status === 'open' && (
                          <button
                            type="button"
                            class="btn btn--primary"
                            data-open-modal="inschrijven"
                            data-cursus-titel={titel}
                            data-cursus-datum={formatDatum(startDatum)}
                            data-cursus-status={status}
                          >Schrijf je in</button>
                        )}
                        {status === 'animo' && (
                          <div class="animo-wrap">
                            <button
                              type="button"
                              class="btn btn--outline"
                              data-open-modal="inschrijven"
                              data-cursus-titel={titel}
                              data-cursus-datum={formatDatum(startDatum)}
                              data-cursus-status={status}
                            >Geef interesse aan</button>
                            <p class="animo-toelichting">Start bij voldoende animo</p>
                          </div>
                        )}
                        {status === 'gesloten' && (
                          <span class="btn btn--muted">Gesloten</span>
                        )}
                      </div>
                    </li>
                  );
                })}
              </ul>
            </div>
          );
        })
      )}
      {binnenkort.length > 0 && (
        <div class="binnenkort-sectie">
          <div class="binnenkort-header">
            <h2>Binnenkort op het programma</h2>
            <p>Voor de onderstaande activiteiten worden binnenkort nieuwe data gepland. Geef alvast vrijblijvend je interesse aan.</p>
          </div>
          <div class="binnenkort-grid">
            {binnenkort.map(c => {
              const bc = c as any;
              const bcTypes: string[] = bc.types ?? [];
              return (
                <div class="binnenkort-kaart" data-types={bcTypes.join(' ')}>
                  <div class="binnenkort-kaart__top">
                    <h3 class="binnenkort-kaart__titel">{bc.titel}</h3>
                    {bcTypes.map(t => (
                      <span class:list={['badge', typekleur[t] ?? 'badge--overig']}>{t}</span>
                    ))}
                  </div>
                  <p class="binnenkort-kaart__beschrijving">{bc.beschrijving}</p>
                  {activiteitLink.has(bc.titel) && (
                    <a href={activiteitLink.get(bc.titel)} class="cursus-lees-meer">Lees meer over deze cursus →</a>
                  )}
                  <ul class="cursus-meta binnenkort-kaart__meta">
                    {bc.bijeenkomsten && (
                      <li>
                        <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                        {bc.bijeenkomsten} {bc.bijeenkomsten === 1 ? 'bijeenkomst' : 'bijeenkomsten'}
                      </li>
                    )}
                    {bc.prijs && (
                      <li>
                        <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10h12"/><path d="M4 14h9"/><path d="M19 6a7.7 7.7 0 0 0-5.2-2A7.9 7.9 0 0 0 6 12a7.9 7.9 0 0 0 7.8 8 7.7 7.7 0 0 0 5.2-2"/></svg>
                        {bc.prijs}
                      </li>
                    )}
                    {bc.doelgroep && (
                      <li>
                        <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                        {bc.doelgroep}
                      </li>
                    )}
                  </ul>
                  <button
                    type="button"
                    class="btn btn--outline binnenkort-kaart__btn"
                    data-open-modal="inschrijven"
                    data-cursus-titel={bc.titel}
                    data-cursus-status="animo"
                  >Geef interesse aan</button>
                </div>
              );
            })}
          </div>
        </div>
      )}
    </div>
  </section>
</PageLayout>

<script>
  // Wordt op astro:page-load (i.p.v. top-level) geïnitialiseerd — zelfde
  // reden als in AgendaKalender.astro: na een client-side navigatie staat
  // de DOM er vers bij, maar top-level code draait dan niet opnieuw.
  function initAgendaFilters() {
    const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter-tag]'));
    const wisBtn = document.querySelector<HTMLButtonElement>('[data-filter-wis]');
    if (chips.length === 0) return;

    const kaarten     = Array.from(document.querySelectorAll<HTMLElement>('.cursus-kaart, .binnenkort-kaart'));
    const maandGroepen = Array.from(document.querySelectorAll<HTMLElement>('.maand-groep'));
    const binnenkortSectie = document.querySelector<HTMLElement>('.binnenkort-sectie');
    // Kalendercellen worden gedimd i.p.v. verborgen — verbergen zou gaten
    // in de vaste 6-rijen-grid slaan (zie KalenderMaand.astro).
    const kalenderCellen = Array.from(document.querySelectorAll<HTMLElement>('.cel--start, .cel--vervolg'));

    function actieveTags(): string[] {
      return chips.filter(c => c.getAttribute('aria-pressed') === 'true').map(c => c.dataset.filterTag!);
    }

    function matcht(el: HTMLElement, actief: string[]): boolean {
      const types = (el.dataset.types ?? '').split(' ').filter(Boolean);
      return actief.length === 0 || types.some(t => actief.includes(t));
    }

    function toepassen() {
      const actief = actieveTags();

      for (const kaart of kaarten) {
        kaart.classList.toggle('cursus-kaart--verborgen', !matcht(kaart, actief));
      }

      for (const cel of kalenderCellen) {
        cel.classList.toggle('cel--gedimd', !matcht(cel, actief));
      }

      for (const groep of maandGroepen) {
        const heeftZichtbare = groep.querySelectorAll('.cursus-kaart:not(.cursus-kaart--verborgen)').length > 0;
        groep.classList.toggle('maand-groep--verborgen', !heeftZichtbare);
      }

      if (binnenkortSectie) {
        const heeftZichtbare = binnenkortSectie.querySelectorAll('.binnenkort-kaart:not(.cursus-kaart--verborgen)').length > 0;
        binnenkortSectie.classList.toggle('maand-groep--verborgen', !heeftZichtbare);
      }

      if (wisBtn) wisBtn.classList.toggle('filter-chip--wis-actief', actief.length > 0);
    }

    chips.forEach(chip => {
      chip.addEventListener('click', () => {
        const actief = chip.getAttribute('aria-pressed') === 'true';
        chip.setAttribute('aria-pressed', String(!actief));
        toepassen();
      });
    });

    wisBtn?.addEventListener('click', () => {
      chips.forEach(c => c.setAttribute('aria-pressed', 'false'));
      toepassen();
    });

    toepassen();
  }

  document.addEventListener('astro:page-load', initAgendaFilters);
</script>

<style>
  .filter-balk {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-10);
  }

  .filter-balk__label {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-text-muted);
  }

  .filter-chip {
    display: inline-flex;
    align-items: center;
    padding: 2px var(--space-3);
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    font-weight: 600;
    font-family: var(--font-body);
    white-space: nowrap;
    border: 2px solid transparent;
    cursor: pointer;
    transition: border-color var(--transition), box-shadow var(--transition), opacity var(--transition);
  }

  .filter-chip[aria-pressed="true"] {
    border-color: currentColor;
  }

  .filter-chip--wis {
    background: none;
    color: var(--color-text-muted);
    font-weight: 700;
    opacity: 0.5;
    pointer-events: none;
  }

  .filter-chip--wis-actief {
    opacity: 1;
    pointer-events: auto;
  }

  .filter-chip--wis-actief:hover {
    color: var(--color-primary);
  }

  .geen-cursussen {
    color: var(--color-text-muted);
    font-size: var(--text-base);
  }

  .maand-groep {
    margin-bottom: var(--space-12);
  }

  .maand-titel {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    font-weight: 600;
    text-transform: capitalize;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-3);
    margin-bottom: var(--space-5);
  }

  .cursus-lijst {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .cursus-kaart {
    display: grid;
    grid-template-columns: 64px 1fr auto;
    gap: var(--space-5);
    align-items: start;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5) var(--space-6);
    scroll-margin-top: 100px;
    transition: border-color 0.4s ease, box-shadow 0.4s ease;
  }

  .cursus-kaart--highlight {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px var(--color-primary-light);
  }

  .cursus-datum-blok {
    display: flex;
    flex-direction: column;
    align-items: center;
    background-color: var(--color-primary-light);
    border-radius: var(--radius-md);
    padding: var(--space-2) var(--space-3);
    text-align: center;
    min-width: 56px;
  }

  .cursus-dag {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--color-primary-dark);
    line-height: 1;
  }

  .cursus-maand {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: var(--space-1);
  }

  .cursus-inhoud {
    min-width: 0;
  }

  .cursus-header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-bottom: var(--space-2);
  }

  .cursus-titel {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
  }

  .cursus-beschrijving {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0 0 var(--space-3);
    line-height: 1.6;
  }

  .cursus-lees-meer {
    display: inline-block;
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-primary);
    text-decoration: none;
    margin-bottom: var(--space-3);
  }

  .cursus-lees-meer:hover {
    text-decoration: underline;
  }

  .cursus-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-3);
  }

  .cursus-meta li {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .cursus-meta svg {
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .overige-data {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1);
    margin: 0;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .overige-data__label {
    font-weight: 600;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .overige-data__datum {
    white-space: nowrap;
  }

  .cursus-actie {
    display: flex;
    align-items: flex-start;
    padding-top: var(--space-1);
  }

  .animo-wrap {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-2);
  }

  .animo-toelichting {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin: 0;
    white-space: nowrap;
  }

  .badge {
