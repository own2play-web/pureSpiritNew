---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import NewsCard from '../components/NewsCard.astro';
import FAQ from '../components/FAQ.astro';
import CtaBottom from '../components/CtaBottom.astro';
import { getCollection } from 'astro:content';
import { nieuwsExcerpt } from '../lib/nieuwsExcerpt';
import homepage from '../data/homepage.json';
import faqData from '../data/faq.json';
import site from '../data/site.json';

// Nieuws
const allNieuws = await getCollection('nieuws');
const latestNieuws = allNieuws
  .sort((a, b) => new Date(b.data.datum).getTime() - new Date(a.data.datum).getTime())
  .slice(0, 3);

// Activiteiten: 1-op-1 uit de content collection + de twee groepsverband-
// categorieën (meditatie/workshops hebben elk hun eigen overzicht met
// varianten, te veel om hier allemaal apart te tonen).
const allDiensten = await getCollection('diensten');
const services = [
  ...allDiensten
    .sort((a, b) => a.data.volgorde - b.data.volgorde)
    .map(d => ({
      title: d.data.titel,
      description: d.data.samenvatting,
      href: `/activiteiten/${d.slug}/`,
      icon: d.data.icon,
      vorm: d.data.vorm,
    })),
  {
    title: 'Meditatie',
    description: 'Verschillende meditatiecursussen, voor kinderen tot volwassenen, in kleine groepjes.',
    href: '/activiteiten/meditatie/',
    icon: '🧘🏻‍♀️',
    vorm: 'groep' as const,
  },
  {
    title: 'Workshops',
    description: 'Losse workshops rond hooggevoeligheid en het omgaan met prikkels.',
    href: '/activiteiten/workshops/',
    icon: '💡',
    vorm: 'groep' as const,
  },
];

// FAQ uit JSON
const faqItems = faqData.items.map(item => ({
  question: item.vraag,
  answer:   item.antwoord,
}));

// Ervaringen uit content collection — uitgelicht op homepage
const allErvaringen = await getCollection('ervaringen');
const testimonials = allErvaringen
  .filter(e => e.data.uitgelicht)
  .sort((a, b) => a.data.volgorde - b.data.volgorde)
  .slice(0, 6);

// Homepage data
const sasjaAlineas = homepage.sasja_tekst.split('\n\n').filter(Boolean);
const hspAlineas   = homepage.hsp_tekst.split('\n\n').filter(Boolean);
---

<BaseLayout
  title="Welkom"
  description="Pure Spirit in Oss biedt Bachbloesemtherapie, Meditatie, Coaching, Begeleiding HSP en Persoonlijke Ontwikkeling. Praktisch, niet-zweverig en op maat."
>
  <!-- Hero -->
  <Hero
    title={homepage.hero_titel}
    subtitle={homepage.hero_subtitel}
    cta={{ label: homepage.hero_cta_label, href: homepage.hero_cta_url }}
    ctaSecondary={{ label: homepage.hero_cta2_label, href: homepage.hero_cta2_url }}
    badge="Zuiverheid · Eenvoud · Kracht"
  />

  <!-- Actueel -->
  {homepage.actueel_actief && (
    <div class="actueel-bar">
      <div class="container">
        <span class="actueel-bar__label">Actueel</span>
        <p>
          {homepage.actueel_bericht}
          {homepage.actueel_link_url && (
            <a href={homepage.actueel_link_url}>{homepage.actueel_link_tekst} →</a>
          )}
        </p>
      </div>
    </div>
  )}

  <!-- Diensten -->
  <section class="section">
    <div class="container">
      <div class="section__header">
        <h2>{homepage.activiteiten_titel}</h2>
        <hr class="divider" />
        <p class="lead">{homepage.activiteiten_subtitel}</p>
      </div>
      <div class="grid grid--3">
        {services.map(s => <ServiceCard {...s} />)}
      </div>
    </div>
  </section>

  <!-- HSP sectie -->
  <section class="section section--alt">
    <div class="container">
      <div class="hsp-grid">
        <div>
          <h2>{homepage.hsp_titel}</h2>
          <hr class="divider" style="margin: var(--space-4) 0 var(--space-6);" />
          {hspAlineas.map((alinea) => (
            <p>{alinea}</p>
          ))}
          <a href={homepage.hsp_cta_url} class="btn btn--outline" style="margin-top: var(--space-4);">{homepage.hsp_cta_label}</a>
        </div>
        <div class="hsp-quote">
          <blockquote>
            "{homepage.hsp_quote}"
          </blockquote>
          <p class="text-muted" style="font-size: var(--text-sm); margin-top: var(--space-3);">— {homepage.hsp_quote_auteur}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Ervaringen -->
  <section class="section">
    <div class="container">
      <div class="section__header">
        <h2>Wat anderen zeggen</h2>
        <hr class="divider" />
        <p class="lead">Je bent in goede handen bij Pure Spirit.</p>
      </div>
      <div class="grid grid--3">
        {testimonials.map(t => (
          <TestimonialCard quote={t.data.quote} author={t.data.auteur} service={t.data.dienst} />
        ))}
      </div>
      <div style="text-align: center; margin-top: var(--space-10);">
        <a href="/ervaringen/" class="btn btn--outline">Alle ervaringen</a>
      </div>
    </div>
  </section>

  <!-- Over Sasja van Geel -->
  <section class="section section--alt">
    <div class="container">
      <div class="about-grid">
        <div class="about-photo">
          <img src={homepage.sasja_foto} alt="Sasja van Geel – Pure Spirit Oss" class="sasja-photo" style={`--positie-mobiel: ${homepage.sasja_foto_positie_mobiel ?? 'center top'}`} />
        </div>
        <div class="about-text">
          <span class="about-eyebrow">{homepage.sasja_eyebrow}</span>
          <h2>{homepage.sasja_titel}</h2>
          <hr class="divider" style="margin: var(--space-4) 0 var(--space-6);" />
          {sasjaAlineas.map((alinea, i) => (
            <p class={i === 0 ? 'lead' : ''}>{alinea}</p>
          ))}
          <a href={homepage.sasja_cta_url} class="btn btn--primary" style="margin-top: var(--space-6);">
            {homepage.sasja_cta_label}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Veelgestelde vragen -->
  <section class="section">
    <div class="container container--narrow">
      <div class="section__header">
        <h2>Veelgestelde vragen</h2>
        <hr class="divider" />
      </div>
      <FAQ items={faqItems} />
    </div>
  </section>

  <!-- Laatste nieuws -->
  {latestNieuws.length > 0 && (
    <section class="section section--alt">
      <div class="container">
        <div class="section__header">
          <h2>Laatste nieuws</h2>
          <hr class="divider" />
        </div>
        <div class="grid grid--3">
          {latestNieuws.map(post => (
            <NewsCard
              title={post.data.titel}
              date={post.data.datum}
              excerpt={nieuwsExcerpt(post.data.samenvatting, post.body)}
              href={`/nieuws/${post.slug}/`}
              category={post.data.categorie}
            />
          ))}
        </div>
        <div style="text-align: center; margin-top: var(--space-10);">
          <a href="/nieuws/" class="btn btn--outline">Alle nieuwsberichten</a>
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <CtaBottom
    title="Klaar om te beginnen?"
    lead="Neem vrijblijvend contact op. We denken graag met je mee welke begeleiding het beste bij jou past."
    primaryLabel="Neem contact op"
    primaryHref="/contact/"
    secondaryLabel={`Bel ${site.telefoon}`}
    secondaryHref={`tel:${site.telefoon.replace(/\s/g,'')}`}
  />
</BaseLayout>

<style>
  .actueel-bar {
    background-color: var(--color-action);
    color: #fff;
    padding-block: var(--space-3);
  }

  .actueel-bar .container {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .actueel-bar__label {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    background-color: rgba(255,255,255,0.25);
    padding: 2px var(--space-3);
    border-radius: var(--radius-full);
    flex-shrink: 0;
  }

  .actueel-bar p {
    font-size: var(--text-sm);
    margin: 0;
    color: #fff;
  }

  .actueel-bar a {
    color: #fff;
    font-weight: 700;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 360px 1fr;
    gap: var(--space-16);
    align-items: center;
  }

  .about-photo {
    position: relative;
  }

  .sasja-photo {
    width: 100%;
    aspect-ratio: 4/5;
    object-fit: cover;
    object-position: center top;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    display: block;
  }

  .about-eyebrow {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: var(--space-3);
  }

  .hsp-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-16);
    align-items: center;
  }

  .hsp-quote {
    /* --color-surface i.p.v. --color-primary-light: deze kaart staat nu in
       een section--alt (goud-getint), en een vaste blauwe tint erbovenop
       botste met dat goud. Wit, net als de andere kaarten (Service/
       Testimonial/News) die ook al op zowel gewone als --alt secties staan. */
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-10);
  }

  .hsp-quote blockquote {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: var(--text-xl);
    color: var(--color-primary-dark);
    line-height: 1.7;
    border: none;
    padding: 0;
    margin: 0;
  }

  @media (max-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
    .sasja-photo {
      aspect-ratio: 4/5;
      max-height: 420px;
      object-position: var(--positie-mobiel, center top);
    }
    .hsp-grid { grid-template-columns: 1fr; gap: var(--space-10); }
  }
</style>
