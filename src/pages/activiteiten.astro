---
import PageLayout from '../layouts/PageLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { getCollection } from 'astro:content';

// Alle activiteiten in één vaste volgorde: de 1-op-1 activiteiten komen uit
// de content collection (CMS-bewerkbaar, gesorteerd op volgorde), Meditatie
// en Workshops zijn twee vaste categorieën die elk hun eigen overzicht van
// varianten hebben (src/content/meditatie, src/content/workshops) en staan
// daarom altijd als laatste twee tiles.
const allDiensten = await getCollection('diensten');
const activiteiten = [
  ...allDiensten
    .sort((a, b) => a.data.volgorde - b.data.volgorde)
    .map(d => ({
      title: d.data.titel,
      description: d.data.samenvatting,
      href: `/activiteiten/${d.slug}/`,
      icon: d.data.icon,
      vorm: d.data.vorm,
    })),
  {
    title: 'Meditatie',
    description: 'Verschillende meditatiecursussen, voor kinderen tot volwassenen, in kleine groepjes.',
    href: '/activiteiten/meditatie/',
    icon: '🧘',
    vorm: 'groep' as const,
  },
  {
    title: 'Workshops',
    description: 'Losse workshops rond hooggevoeligheid en het omgaan met prikkels.',
    href: '/activiteiten/workshops/',
    icon: '💡',
    vorm: 'groep' as const,
  },
];
---

<PageLayout
  title="Activiteiten"
  heroTitle="Onze activiteiten"
  heroSubtitle="Van Bachbloesemtherapie tot meditatiecursussen, altijd praktisch, persoonlijk en op maat."
>
  <section class="section">
    <div class="container">
      <div class="section__header">
        <h2>Alle activiteiten</h2>
        <hr class="divider" />
        <p class="lead">Voor alle leeftijden: kinderen, jongeren en volwassenen. Altijd praktisch en op jouw maat.</p>
      </div>
      <div class="grid grid--3">
        {activiteiten.map(s => <ServiceCard {...s} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container container--narrow" style="text-align: center;">
      <h2>Niet zeker welke activiteit bij jou past?</h2>
      <p class="lead" style="margin-bottom: var(--space-8);">
        Neem gerust contact op. We denken graag met je mee welke begeleiding
        het beste aansluit bij jouw situatie.
      </p>
      <a href="/contact/" class="btn btn--primary">Neem contact op</a>
    </div>
  </section>
</PageLayout>
